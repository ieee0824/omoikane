+// Temporary measurements for #1141. This diagnostic branch is not merged.
+#[cfg(feature = "jit-stress")]
+mod acid3_profile {
+    use std::cell::RefCell;
+    use std::time::Instant;
+
+    const LABELS: [&str; 9] = [
+        "get_element_by_id",
+        "create_element",
+        "append_child",
+        "insert_before",
+        "remove_child",
+        "get_attribute",
+        "set_attribute",
+        "create_text_node",
+        "node_to_js_value",
+    ];
+
+    #[derive(Clone, Copy, Default)]
+    struct Stat {
+        calls: u64,
+        nanoseconds: u64,
+    }
+
+    struct State {
+        active: bool,
+        stats: [Stat; LABELS.len()],
+    }
+
+    thread_local! {
+        static STATE: RefCell<State> = const { RefCell::new(State {
+            active: false,
+            stats: [Stat { calls: 0, nanoseconds: 0 }; LABELS.len()],
+        }) };
+    }
+
+    pub(super) struct Timer {
+        index: usize,
+        started: Option<Instant>,
+    }
+
+    impl Timer {
+        pub(super) fn new(index: usize) -> Self {
+            let active = STATE.with(|state| state.borrow().active);
+            Self {
+                index,
+                started: active.then(Instant::now),
+            }
+        }
+    }
+
+    impl Drop for Timer {
+        fn drop(&mut self) {
+            let Some(started) = self.started else { return };
+            let elapsed = u64::try_from(started.elapsed().as_nanos()).unwrap_or(u64::MAX);
+            STATE.with(|state| {
+                let mut state = state.borrow_mut();
+                let stat = &mut state.stats[self.index];
+                stat.calls = stat.calls.saturating_add(1);
+                stat.nanoseconds = stat.nanoseconds.saturating_add(elapsed);
+            });
+        }
+    }
+
+    pub(super) fn begin() {
+        STATE.with(|state| {
+            let mut state = state.borrow_mut();
+            state.stats = [Stat::default(); LABELS.len()];
+            state.active = true;
+        });
+    }
+
+    pub(super) fn finish() -> serde_json::Value {
+        let stats = STATE.with(|state| {
+            let mut state = state.borrow_mut();
+            state.active = false;
+            state.stats
+        });
+        serde_json::Value::Object(
+            LABELS
+                .iter()
+                .enumerate()
+                .map(|(index, label)| {
+                    let stat = stats[index];
+                    (
+                        (*label).to_string(),
+                        serde_json::json!({
+                            "calls": stat.calls,
+                            "nanoseconds": stat.nanoseconds,
+                        }),
+                    )
+                })
+                .collect(),
+        )
+    }
+}
+
+/// Starts temporary native-call timings for the Acid3 test26 investigation.
+#[cfg(feature = "jit-stress")]
+#[doc(hidden)]
+pub fn acid3_native_profile_begin() {
+    acid3_profile::begin();
+}
+
+/// Finishes temporary native-call timings for the Acid3 test26 investigation.
+#[cfg(feature = "jit-stress")]
+#[doc(hidden)]
+pub fn acid3_native_profile_finish() -> serde_json::Value {
+    acid3_profile::finish()
+}
