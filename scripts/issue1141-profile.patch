@@ -44,0 +45,32 @@ thread_local! {
+#[cfg(feature = "jit-stress")]
+fn begin_test26_profile(runtime: &JsRuntime) -> omoikane::js::BaselineJitDiagnostics {
+    boa_gc::reset_profile();
+    omoikane::js::acid3_native_profile_begin();
+    runtime.baseline_jit_diagnostics()
+}
+
+#[cfg(feature = "jit-stress")]
+fn finish_test26_profile(
+    runtime: &JsRuntime,
+    mode: DriveMode,
+    jit_before: omoikane::js::BaselineJitDiagnostics,
+    wall_ms: f64,
+) {
+    let gc = boa_gc::profile();
+    eprintln!(
+        "ACID3_PROFILE {}",
+        serde_json::json!({
+            "mode": format!("{mode:?}"),
+            "jit_enabled": std::env::var_os("OMOIKANE_ACID3_DISABLE_JIT").is_none(),
+            "wall_ms": wall_ms,
+            "gc_minor_count": gc.minor.collections,
+            "gc_minor_ms": gc.minor.total.as_secs_f64() * 1000.0,
+            "gc_major_count": gc.major.collections,
+            "gc_major_ms": gc.major.total.as_secs_f64() * 1000.0,
+            "jit_before": jit_before,
+            "jit_after": runtime.baseline_jit_diagnostics(),
+            "native": omoikane::js::acid3_native_profile_finish(),
+        })
+    );
+}
